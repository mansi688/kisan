# ---- Core ----------------------------------------------------------------
PORT=4000
# Long random string. REQUIRED to be changed when NODE_ENV=production — the
# server refuses to start in production with this placeholder.
JWT_SECRET=change-this-to-a-long-random-string
# "development" locally. Set to "production" on a real deployment (hides error
# detail from API responses and enables the JWT_SECRET safety check).
NODE_ENV=development

# ---- Demo Mode -----------------------------------------------------------
# Lets anyone enter the seeded Farmer / Financer / Warehouse demo accounts with
# no password or OTP via /demo. Great for a demo deployment — set to "false"
# for a real production launch. (If this line is missing, it defaults to true.)
DEMO_MODE=true

# ---- Seeding (npm run seed) ------------------------------------------------
# Admin login is username "admin". Set ADMIN_PASSWORD for any deployment other
# than your own laptop; unset falls back to the documented default in README.
# ADMIN_PASSWORD=
# SEED_DEMO=false skips ALL demo accounts and sample warehouses (admin only).
# SEED_DEMO=true

# ---- Deployment ----------------------------------------------------------
# Behind a reverse proxy / PaaS (Render, Railway, Fly, nginx): set to 1 so the
# login rate limiter sees real client IPs instead of the proxy's.
# TRUST_PROXY=1
# Set to "true" once the site is served over HTTPS, to add
# upgrade-insecure-requests to the Content-Security-Policy.
# FORCE_HTTPS=false
# Where the built website lives (default: ../web/dist, built by `npm run build`).
# WEB_DIST=

# ---- Browser origins (only needed if the site is served from a DIFFERENT
# origin than this API, e.g. Vite dev server). Same-origin needs nothing.
# Default already covers http://localhost:5173-5176 and 127.0.0.1 equivalents.
# CORS_ORIGIN=https://your-frontend.example.com

# ---- Database ------------------------------------------------------------
# "json" (default — zero-config files under backend/data/) or "postgres"
# (needs DATABASE_URL, and `npm run migrate` applied first).
DB_DRIVER=json
# DATABASE_URL=postgres://kisanunnatti:password@localhost:5432/kisanunnatti
